<Project Sdk="Microsoft.NET.Sdk">
  <!-- FM27 Crimson Inspector - built against the FM27 BepInEx 6 IL2CPP interop (inspector-spec.md). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FM27Inspector</AssemblyName>
    <RootNamespace>Crimson.Inspector</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Fm27>C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27\BepInEx</Fm27>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(Fm27)\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(Fm27)\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(Fm27)\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Fm27)\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Fm27)\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(Fm27)\interop\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(Fm27)\interop\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Fm27)\interop\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SI.Bindable"><HintPath>$(Fm27)\interop\SI.Bindable.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SI.UI"><HintPath>$(Fm27)\interop\SI.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
